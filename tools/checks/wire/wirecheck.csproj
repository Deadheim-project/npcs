<Project Sdk="Microsoft.NET.Sdk">

  <!-- Roda fora do jogo, contra a NpcValheim.dll de verdade. Nao substitui a suite que
       roda dentro do Valheim: cobre o que da para verificar sem uma partida, que e
       justamente o que mais quebra em silencio - formato de rede e leitura de conteudo.
       Compile e execute com tools/checks/run.ps1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>wirecheck</AssemblyName>
    <RestoreSources>https://api.nuget.org/v3/index.json</RestoreSources>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="NpcValheim"><HintPath>..\..\..\NpcValheim\bin\Release\NpcValheim.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>true</Private></Reference>
    <!-- Referenciada pelo caminho publicizado, mas copiada com o nome da identidade:
         o carregador procura assembly_valheim.dll, e o arquivo em disco se chama
         assembly_valheim_publicized.dll. -->
    <Reference Include="assembly_valheim"><HintPath>$(ValheimPublicized)\assembly_valheim_publicized.dll</HintPath><Private>false</Private></Reference>
    <None Include="$(ValheimPublicized)\assembly_valheim_publicized.dll"
          Link="assembly_valheim.dll" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="UnityEngine"><HintPath>$(ValheimManaged)\UnityEngine.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ValheimManaged)\UnityEngine.CoreModule.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="netstandard"><HintPath>$(ValheimManaged)\netstandard.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>

</Project>
