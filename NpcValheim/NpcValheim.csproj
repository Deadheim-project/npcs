<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>NpcValheim</AssemblyName>
    <RootNamespace>NpcValheim</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx / Harmony -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Valheim game code (publicized so internal/private members are accessible) -->
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimPublicized)\assembly_valheim_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ValheimManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ValheimPublicized)\assembly_utils_publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Localization lives here, not in assembly_valheim. It is what turns "$item_hammer"
         into the name the player actually reads. -->
    <Reference Include="assembly_guiutils">
      <HintPath>$(ValheimManaged)\assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Minimap.AddPin's signature mentions PlatformUserID, which lives here. Needed to
         reference the type even though the mod never names it. -->
    <Reference Include="Splatform">
      <HintPath>$(ValheimManaged)\Splatform.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity engine modules used by NPC / UI / interaction code -->
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ValheimManaged)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ValheimManaged)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ValheimManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ValheimManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ValheimManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ValheimManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreTextEngineModule">
      <HintPath>$(ValheimManaged)\UnityEngine.TextCoreTextEngineModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ValheimManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ValheimManaged)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.19" />
    <!-- Fixado EXATAMENTE na versão que o modpack do servidor instala
         (ValheimModding-YamlDotNet 16.3.0, assembly 16.0.0.0). BepInEx carrega um
         YamlDotNet só: se o mod trouxer outra versão, uma das duas perde.

         Os colchetes não são decoração. "16.3.1" era um intervalo mínimo, e essa
         versão nunca saiu como estável, só como prerelease, então o NuGet
         resolvia 17.0.0 e avisava num NU1603 que passou despercebido em todo
         build. O resultado era compilar contra uma API mais nova do que a que
         existe em runtime: qualquer método adicionado depois da 16.3 compilaria
         e só quebraria dentro do jogo. -->
    <PackageReference Include="YamlDotNet" Version="[16.3.0]">
      <!-- Compila contra ela, mas não a copia para a saída: quem entrega o
           YamlDotNet em runtime é o pacote do modpack. -->
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- JetBrains.Annotations not referenced as a package: UnityEngine.CoreModule already
         ships PublicAPI/UsedImplicitly in that same namespace, which ConfigSync.cs uses. -->
  </ItemGroup>

  <!-- A suite de testes e as ferramentas de demo agora vivem em NpcValheim.Server, que
       nunca e distribuido. DevTools continua existindo so para a conveniencia de
       desenvolvimento (CopyToPlugins) e para o zip nao trocar a dll de teste do jogo. -->
  <PropertyGroup>
    <DevTools Condition="'$(DevTools)' == ''">true</DevTools>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Assets\Mailbox\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Conteudo pronto (quests e modelos de NPC importados). Vai junto com a dll: o
         ContentSeeder copia dali para npcs/ na primeira execucao. -->
    <ShippedQuests Include="Content\quests\*.yaml" />
    <ShippedTemplates Include="Content\templates\*.yaml" />
  </ItemGroup>

  <!-- Drop the built plugin straight into the game's plugin folder for quick in-game testing -->
  <!-- Conveniencia de desenvolvimento. Nao roda na compilacao de distribuicao: essa
       produz a dll limpa para o zip, e nao deve trocar a dll de teste no jogo. -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(DevTools)' == 'true'">
    <MakeDir Directories="$(BepInExPlugins)\NpcValheim" Condition="!Exists('$(BepInExPlugins)\NpcValheim')" />
    <MakeDir Directories="$(BepInExPlugins)\NpcValheim\Assets\Mailbox" Condition="!Exists('$(BepInExPlugins)\NpcValheim\Assets\Mailbox')" />
    <MakeDir Directories="$(BepInExPlugins)\NpcValheim\Content\quests;$(BepInExPlugins)\NpcValheim\Content\templates" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(BepInExPlugins)\NpcValheim" />
    <Copy SourceFiles="$(TargetDir)LiteDB.dll" DestinationFolder="$(BepInExPlugins)\NpcValheim" Condition="Exists('$(TargetDir)LiteDB.dll')" />
    <Copy SourceFiles="$(ProjectDir)Assets\Mailbox\model.bin;$(ProjectDir)Assets\Mailbox\basecolor.png;$(ProjectDir)Assets\Mailbox\normal.png;$(ProjectDir)Assets\Mailbox\hud-icon.png;$(ProjectDir)Assets\Mailbox\Selo_Png.png;$(ProjectDir)Assets\Mailbox\Selo_Icon.png;$(ProjectDir)Assets\Mailbox\Selo_Icon.jpeg"
          DestinationFolder="$(BepInExPlugins)\NpcValheim\Assets\Mailbox"
          Condition="Exists('$(ProjectDir)Assets\Mailbox\model.bin')" />
    <Copy SourceFiles="@(ShippedQuests)" DestinationFolder="$(BepInExPlugins)\NpcValheim\Content\quests" />
    <Copy SourceFiles="@(ShippedTemplates)" DestinationFolder="$(BepInExPlugins)\NpcValheim\Content\templates" />
    <!-- YamlDotNet de propósito não entra aqui: vem do modpack (ValheimModding-YamlDotNet). -->
  </Target>

</Project>
